# ─────────────────────────────────────────────
# 줄바꿈 정규화
# 저장소에는 LF로 보관한다. Windows·macOS 혼용 시 발생하는
# 전체 파일 재작성 diff를 막는다.
# ─────────────────────────────────────────────
* text=auto eol=lf

*.md       text eol=lf
*.py       text eol=lf
*.json     text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.txt      text eol=lf
*.ini      text eol=lf
*.cfg      text eol=lf
*.toml     text eol=lf
*.sh       text eol=lf

# Windows 전용 스크립트는 CRLF 유지
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# ─────────────────────────────────────────────
# 언리얼 소스 · 설정
# ─────────────────────────────────────────────
*.cpp      text eol=lf diff=cpp
*.h        text eol=lf diff=cpp
*.cs       text eol=lf diff=csharp
*.uproject text eol=lf
*.uplugin  text eol=lf
*.usf      text eol=lf
*.ush      text eol=lf

# ─────────────────────────────────────────────
# Git LFS
#
# Unreal 바이너리와 대용량 미디어는 Git LFS로 관리한다.
#
# clone 전에 각자 `git lfs install`을 한 번 실행한다.
# 실행하지 않으면 에셋이 포인터 텍스트로 내려받아져 언리얼에서 열리지 않는다.
#
# `lockable` — 체크아웃 시 읽기 전용이 된다. 편집하려면 먼저 잠근다.
#     git lfs lock   vr/testproj/Content/.../BP_X.uasset
#     git lfs unlock vr/testproj/Content/.../BP_X.uasset
# .uasset·.umap 은 병합이 불가능하므로 동시 편집을 도구로 막는다.
# ─────────────────────────────────────────────
*.uasset  filter=lfs diff=lfs merge=lfs -text lockable
*.umap    filter=lfs diff=lfs merge=lfs -text lockable
*.fbx     filter=lfs diff=lfs merge=lfs -text
*.glb     filter=lfs diff=lfs merge=lfs -text
*.gltf    filter=lfs diff=lfs merge=lfs -text
*.obj     filter=lfs diff=lfs merge=lfs -text
*.ply     filter=lfs diff=lfs merge=lfs -text
*.stl     filter=lfs diff=lfs merge=lfs -text
*.psd     filter=lfs diff=lfs merge=lfs -text
*.wav     filter=lfs diff=lfs merge=lfs -text
*.ttf     filter=lfs diff=lfs merge=lfs -text
*.otf     filter=lfs diff=lfs merge=lfs -text

# 텍스처 — 유물 텍스처는 수십 MB 단위다. 반드시 LFS로 간다.
*.png     filter=lfs diff=lfs merge=lfs -text
*.jpg     filter=lfs diff=lfs merge=lfs -text
*.jpeg    filter=lfs diff=lfs merge=lfs -text
*.tga     filter=lfs diff=lfs merge=lfs -text
*.exr     filter=lfs diff=lfs merge=lfs -text
*.hdr     filter=lfs diff=lfs merge=lfs -text
